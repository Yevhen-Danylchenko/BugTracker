@model BugTracker.Models.Bug

@{
    ViewData["Title"] = "Create Bug";
}

<h2>Create Bug</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<PriorityEnum>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusEnum>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="AssignedTo" class="form-label"></label>
        <input asp-for="AssignedTo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ReportedBy" class="form-label"></label>
        <input asp-for="ReportedBy" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

